# ==========================================================================
# Instagram Story Cron — configuration
# Copy this file to `.env` and fill the values. NEVER commit `.env`.
# ==========================================================================

# --- Meta developer app (dashboard: developers.facebook.com) ---------------
APP_ID=                      # "Identificador de la aplicación"
APP_SECRET=                  # "Secret de la aplicación" (Configuracion -> Basica)

# --- Facebook page owning the Instagram account ------------------------------
# Numeric ID of your brand page (e.g. from Business Suite URL: asset_id=...).
# Recommended: filling it skips the flaky /me/accounts discovery.
PAGE_ID=1397568803431045

# --- Instagram access token -------------------------------------------------
# From Graph API Explorer: developers.facebook.com/tools/explorer
# Short-lived (EAAG...) is fine as a start — the script converts it to a
# long-lived (60-day) token on the first run and stores it in .env.
IG_USER_TOKEN=
IG_BUSINESS_ACCOUNT_ID=      # optional: auto-discovered from your linked Page

# --- Public hosting of the story images -------------------------------------
# The API fetches each image from a PUBLIC url. Cheapest free option: put the
# images in a PUBLIC GitHub repo and serve them through jsDelivr CDN, e.g.:
#   PUBLIC_BASE_URL=https://cdn.jsdelivr.net/gh/yourGHuser/yourGHrepo@main/stories
# so stories/story1.jpg becomes
#   https://cdn.jsdelivr.net/gh/yourGHuser/yourGHrepo@main/stories/story1.jpg
PUBLIC_BASE_URL=

# --- Schedule ----------------------------------------------------------------
PUBLISH_INTERVAL_H=3         # publish every N hours (matches your cron)

# --- AI writer (opencode, para el flag --ai-caption) ------------------------
# AI_MODEL=opencode-go/mimo-v2.6-flash  # id via catálogo OpenCode Go (barato)
# AI_BRAND_VOICE=              # opcional: override del prompt de voz de marca
# OPENCODE_API_KEY=            # SOLO en GitHub Actions (secret): tu key de opencode.ai (Go)
# DEEPSEEK_API_KEY=            # opcional (si prefieres BYOK deepseek/deepseek-v4-flash)

# --- NOT needed for this pipeline -------------------------------------------
# The "Instagram app secret" (lopcprospa - IG) is NOT needed to publish via the
# Graph API user token. Leave it out.